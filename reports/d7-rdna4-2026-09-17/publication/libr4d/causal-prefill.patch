+                    cu,
+                    sidx,
+                    None,
+                    1,
+                    48,
+                    16,
+                    128**-0.5,
+                )
+                torch.cuda.synchronize()
+                rows.append(
+                    {
+                        "fixture": name,
+                        "kind": "prefix",
+                        "tokens": end,
+                        "controls_ok": prefix_ok,
+                        "exact": exact(short, output[:end]),
