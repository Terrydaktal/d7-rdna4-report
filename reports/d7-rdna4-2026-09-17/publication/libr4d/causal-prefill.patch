+            bank = torch.zeros((2, 48, 128, 128), device="cuda", dtype=torch.float32)
+            bank[1] = nonzero[0]
+            native_out = torch.empty_like(resumed_out)
+            resume_cu = torch.tensor([0, 65], device="cuda", dtype=torch.int32)
